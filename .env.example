# ==============================================================================
# Food Donation and Distribution Management System - Environment Configuration
# ==============================================================================

# MySQL Database connection URL (Prisma ORM)
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
DATABASE_URL="mysql://root:your_mysql_password@localhost:3306/food_donation_db"

# MongoDB connection URI (Activity logs & audit events)
# Format: mongodb://[USER:PASSWORD@]HOST:PORT/DATABASE_NAME
MONGODB_URI="mongodb://localhost:27017/food_donation_audit"

# JSON Web Token secret key for server-side auth session cookies
JWT_SECRET="change_this_to_a_secure_random_secret_in_production"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Node Environment
NODE_ENV="development"
